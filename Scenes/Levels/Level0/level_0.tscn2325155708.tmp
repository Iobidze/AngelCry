[node name="Pic" parent="Navigator/TileMapLayer" unique_id=945574007 instance=ExtResource("4_d5a6o")]
position = Vector2(-378, -130)
textLetter = "Икона Святого Георгия"

[node name="Pic4" parent="Navigator/TileMapLayer/Pic" unique_id=30299728 instance=ExtResource("4_d5a6o")]
position = Vector2(755, -20)
textLetter = "Ты видишь план, помещения. Справа находится Лавка, через которую есть проход на склад, дальше Столова, выше находится кабинет Священика. Слевва Гардеробная, проход на Колокольню, и влевом верхнем углу находтся какоето техническое помещение. В центре зал."

[node name="Pic2" parent="Navigator/TileMapLayer/Pic" unique_id=1295072698 instance=ExtResource("4_d5a6o")]
